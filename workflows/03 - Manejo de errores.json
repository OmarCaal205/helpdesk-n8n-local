      "id": "460edffa-9d5f-4481-8ec6-58659e1ab7fe",
      "name": "Capturar error del sistema"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const error = $json;\n\nconst workflowName =\n  error.workflow?.name ||\n  error.execution?.workflowName ||\n  \"Workflow no identificado\";\n\nconst nodeName =\n  error.node?.name ||\n  error.execution?.lastNodeExecuted ||\n  \"Nodo no identificado\";\n\nconst message =\n  error.error?.message ||\n  error.message ||\n  \"Error no especificado\";\n\nreturn {\n  json: {\n    workflow: workflowName,\n    nodo: nodeName,\n    mensaje_error: message,\n    datos: JSON.stringify(error),\n    fecha: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "f529774d-fd38-4ce7-89c3-71c41a4dc193",
      "name": "Preparar detalle del error"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO errores (\n  workflow,\n  nodo,\n  mensaje_error,\n  datos\n)\nVALUES (\n  '{{ $json.workflow }}',\n  '{{ $json.nodo }}',\n  '{{ $json.mensaje_error }}',\n  '{{ $json.datos }}'::jsonb\n)\nRETURNING *;",
        "options": {}
      },
